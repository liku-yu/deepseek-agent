# 复制本文件为 .env 并填入你的 DeepSeek API key。
# 或者直接用环境变量：
#   Git Bash:   export DEEPSEEK_API_KEY=sk-xxx
#   PowerShell: $env:DEEPSEEK_API_KEY="sk-xxx"
#   cmd:        set DEEPSEEK_API_KEY=sk-xxx
# 说明：key 不会被打进 exe，运行时从环境变量或 .env 动态读取。
DEEPSEEK_API_KEY=sk-你的key

# --- 以下为可选配置（默认值已在 agent.py 中，通常不用改）---
# DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp
# DEEPSEEK_EFFORT=high
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1
# DEEPSEEK_CMD_TIMEOUT=120
